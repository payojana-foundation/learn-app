    "build-courses": "node scripts/build-courses.mjs",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "deploy-check": "node scripts/verify-deploy.mjs",
    "check": "tsc --noEmit && vitest --run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.7.0",
