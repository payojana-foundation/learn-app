    "playwright": "^1.64.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "idb": "^8.0.3"
