# P-14 (bulk 09): Learn plays its own R2 audio only and renders no iframe, so no host
# may be framed at all. (frame-src alone does not restrict any other resource type.)
/*
  Content-Security-Policy: frame-src 'none'

/data/*
  Cache-Control: no-cache

# Reliable updates: never let the browser or edge serve a stale service worker
# or app-shell entry point. The SW update check and the initial HTML must
# always reach the network so a new deploy is picked up. The hashed assets in
# /assets/* are immutable and keep their long-lived cache (default).
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# version.json (R6): the post-deploy check reads the live build hash from here,
# so it must always be the fresh copy, never a cached one.
/version.json
  Cache-Control: no-cache
